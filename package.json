{
  "name": "sa-id-validator",
  "version": "0.1.0",
  "private": true,
  "homepage": "/sa-id-validator",
  "dependencies": {
    "@cloudscape-design/components": "^3.0.574",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@zxing/browser": "^0.1.5",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "tesseract.js": "^5.1.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "client": "react-scripts start",
    "server": "nodemon server/index.js",
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:server": "node --test server",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "description": "Full-stack South African ID validation with bulk/fraud checks, SASSA grant pre-screening, and POPIA-conscious auditing.",
  "main": "server/index.js",
  "keywords": [
    "south-africa",
    "id-validation",
    "luhn",
    "sassa",
    "popia",
    "govtech"
  ],
